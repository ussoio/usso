PROJECT_NAME=
DOMAIN=

# Keep disabled outside isolated local development. OTP generation remains random.
DEBUG=0
MONGO_URI=mongodb://localhost:27017/
REDIS_URI=redis://localhost:6379/

# Generate at least 32 random bytes; never reuse an account password.
SYSTEM_PASSWORD=

JWT_CONFIG=
# Generate at least 32 random bytes and share it across replicas.
CAPTCHA_KEY=

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXY_NETWORKS=
FORWARDED_ALLOW_IPS=172.18.0.0/16
MAX_REQUEST_BODY_BYTES=1048576

# Leave empty during pytest so integration tests use dummy channels and skip live sends.
# Uncomment only for manual messaging checks (see tests/messaging/).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=
# SMTP_USE_TLS=
# SMTP_USE_SSL=
# SMTP_VERIFY_SSL=

# KAVENEGAR_API_KEY=
# USSO_BALE_CLIENT_ID=
# USSO_BALE_CLIENT_SECRET=

JIBIT_API_KEY=
JIBIT_SECRET_KEY=

USSO_GOOGLE_CLIENT_ID=
USSO_GOOGLE_CLIENT_SECRET=

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=
SUPERADMIN_NAME=

PROXY=

# Optional public OAuth client (device-code, no secret) provisioned on every tenant at startup.
BOOTSTRAP_PUBLIC_CLIENT_ID=
BOOTSTRAP_PUBLIC_CLIENT_NAME=
BOOTSTRAP_PUBLIC_CLIENT_REDIRECT_URIS=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3036

# Resource servers (comma-separated URLs) that openly registered MCP clients get tokens for.
OAUTH_DYNAMIC_CLIENT_AUDIENCES=

# Optional trusted deployment modules, each exporting install(app).
USSO_EXTENSION_MODULES=
# Additional hosts allowed to receive trace identifiers.
TRACE_PROPAGATE_HOSTS=
