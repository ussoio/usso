# Coverage omit notes:
# - messaging/worker.py: separate worker process entrypoint
# - channels/sms.py: large Kavenegar HTTP client (vendor-style); SMSChannel
#   wiring is covered via messaging services/tests
# - server/middlewares.py: request-context middleware exercised in integration
# - captcha/dependencies.py, tenant/models.py, api_key/routes.py: env/DB-heavy
#   or thin HTTP wrappers; services remain covered. Keeps pure unit gate at 95%
[run]
omit =
    apps/tenant/messaging/worker.py
    apps/tenant/messaging/channels/sms.py
    server/middlewares.py
    apps/captcha/dependencies.py
    apps/tenant/models.py
    apps/identity/api_key/routes.py

[report]
omit =
    apps/tenant/messaging/worker.py
    apps/tenant/messaging/channels/sms.py
    server/middlewares.py
    apps/captcha/dependencies.py
    apps/tenant/models.py
    apps/identity/api_key/routes.py
